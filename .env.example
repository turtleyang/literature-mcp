# 启动自动读取项目根 .env；也可用 LITERATURE_ENV_FILE 指向外部私有文件。
# 进程已有环境变量优先。真实凭据只放权限为 600 的私有 .env。
WOS_API_KEY=
WOS_EXPANDED_API_KEY=
WOS_STARTER_VERSION=v2
ELSEVIER_API_KEY=
SCOPUS_SEARCH_API_KEY=
ELSEVIER_INST_TOKEN=
SPRINGER_API_KEY=
SPRINGER_OPENACCESS_API_KEY=
SPRINGER_TDM_API_KEY=
WILEY_TDM_TOKEN=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
# 必须是你的真实联系邮箱，不能用虚构邮箱请求 Unpaywall。
UNPAYWALL_EMAIL=

# 只有确认具有对应 API/TDM 授权后才填相应名字，逗号分隔。
# 检索授权：wos_starter,wos_expanded,scopus,sciencedirect,springer
# 全文授权：wiley,elsevier,springer_oa,springer_tdm
# 一个名字不授予其他产品的权限；API Key 不等于全文许可。
LITERATURE_AUTHORIZED_APIS=
# 留空使用项目内 literature-library；自定义时应填绝对路径。
LITERATURE_LIBRARY_DIR=
# 额外保存根目录，分号分隔绝对路径。留空只允许写入文献库。
LITERATURE_ALLOWED_SAVE_ROOTS=
LITERATURE_HTTP_TIMEOUT_MS=15000
LITERATURE_DOWNLOAD_TIMEOUT_MS=90000
LITERATURE_MAX_FILE_MB=50
LITERATURE_MAX_CANDIDATES=6
LITERATURE_SEARCH_CONCURRENCY=3
LITERATURE_DOWNLOAD_CONCURRENCY=1
LITERATURE_DOWNLOAD_ORDER=arxiv,pmc,unpaywall,openalex,semantic_scholar,springer_oa,wiley,elsevier,springer_tdm
# Elsevier 默认获取原生 XML。仅确认有 PDF 权限后设为 pdf。
ELSEVIER_FULLTEXT_FORMAT=xml
# 可选 HTTP CONNECT 代理；不修改系统代理。SOCKS 应通过本地 HTTP 入口转接。
HTTPS_PROXY=
# 仅在本机 Clash Fake-IP DNS 确实启用时设置精确可信域名。
# 不接受通配符；普通网络保持空。内网地址仍禁止，TLS 证书校验始终开启。
LITERATURE_TRUSTED_FAKE_IP_HOSTS=
