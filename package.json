{
  "name": "literature-mcp",
  "version": "1.1.0",
  "private": true,
  "description": "Local, source-aware literature discovery and authorized full-text MCP server",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "literature-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:online": "node scripts/online-test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run smoke && npm run format:check && npm audit --omit=dev",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"scripts/*.mjs\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.mjs\" \"scripts/*.mjs\" package.json tsconfig.json",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.12.0",
    "paper-search-mcp-nodejs": "0.3.3",
    "pdfjs-dist": "6.5.438",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "paper-search-mcp-nodejs": {
      "zod": "4.6.7"
    }
  }
}
